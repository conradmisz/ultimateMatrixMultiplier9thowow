`verilator_config
lint_off -file "*rtl/vendor/picorv32.v"
// picorv32.v's `timescale directive leaks past its own file (Verilator's
// TIMESCALEMOD check is project-wide, not per-file), flagging every other
// module in the build as "missing timescale". Suppress the rule globally
// here rather than touching the vendor source or adding timescales project-wide.
lint_off -rule TIMESCALEMOD
